{
  "$schema": "../nafura-platform/sources/web/platform/schemas/app.nafura.schema.json",
  "apiVersion": "nafura.io/v1",
  "kind": "application",
  "metadata": { "id": "app.anatomy-sandbox", "version": "0.1.0", "owner": "nafuralabs", "lifecycle": "experimental" },
  "spec": {
    "product": { "name": "Anatomy", "tagline": "Platform lab" },
    "runtime": { "tenancy": "single", "defaultRoute": "/" },
    "shell": {
      "topBar": { "enabled": true, "pageContext": true },
      "sidebar": { "enabled": true },
      "userMenu": { "enabled": true, "userSettings": true },
      "tenantMenu": {
        "enabled": true,
        "tenantSettings": true,
        "tenantSettingsRoute": "/organization/settings",
        "organizationIdentity": true,
        "organizationIdentityRoute": "/organization/identity",
        "fallbackName": "Sandbox",
        "fallbackKey": "sandbox"
      },
      "notifications": { "enabled": true },
      "ai": { "enabled": true }
    },
    "businessContexts": ["bc.achats"],
    "capabilities": { "disabled": ["cap.document-extraction", "cap.geo"] },
    "i18n": { "namespace": "app.anatomy-sandbox", "locales": ["fr"] }
  }
}
