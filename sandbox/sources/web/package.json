{
  "name": "@nafura/anatomy-sandbox",
  "version": "0.0.1",
  "private": true,
  "description": "Sandbox — sandbox for screen archetypes and nf-* components",
  "scripts": {
    "stack:check": "node ../../../nafura-platform/scripts/sync-stack-versions.mjs --check",
    "stack:sync": "node ../../../nafura-platform/scripts/sync-stack-versions.mjs --write",
    "architecture:check": "node --experimental-strip-types --test ../../../nafura-platform/sources/web/platform/manifest-validator.test.mjs ../../../nafura-platform/sources/web/platform/manifest-projection.test.mjs ../../../nafura-platform/sources/web/platform/manifest-schema.test.mjs ../../../nafura-platform/sources/web/platform/host/host-plan.test.mjs ../../../nafura-platform/sources/web/platform/host/host-screens.test.mjs ../../../nafura-platform/sources/web/core/icons/app-lucide-icons.test.mjs ../../../nafura-platform/sources/web/platform/host/i18n/platform-i18n.test.mjs ../../../nafura-platform/sources/web/platform/host/product-boundary.test.mjs ../../../nafura-platform/sources/web/platform/app-shell/navigation-access.test.mjs ../../../nafura-platform/sources/web/core/navigation/sidebar-tree.test.mjs ../../../nafura-platform/sources/web/platform/listing/listing-config.test.mjs ../../../nafura-platform/sources/web/lib/anatomy/utils/relative-time.test.mjs ../../../nafura-platform/sources/web/lib/anatomy/utils/cron-label.test.mjs",
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4300",
    "build": "npm run architecture:check && ng build",
    "build:dev": "npm run architecture:check && ng build --configuration development"
  },
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@ngx-translate/core": "^15.0.0",
    "chart.js": "^4.5.1",
    "lucide-angular": "^0.563.0",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.5",
    "typescript": "~6.0.3"
  }
}
