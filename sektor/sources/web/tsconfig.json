{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      // Sektor → @platform/* . @core/@lib/@features/@services : pont pour le
      // compilation unit Angular qui charge encore nafura-platform (hors périmètre).
      "@platform/*": ["../../../nafura-platform/sources/web/*"],
      "@core/*": ["../../../nafura-platform/sources/web/core/*"],
      "@core/security": ["../../../nafura-platform/sources/web/core/security/index.ts"],
      "@lib/*": ["../../../nafura-platform/sources/web/lib/*"],
      "@features/*": ["../../../nafura-platform/sources/web/features/*"],
      "@services/*": ["../../../nafura-platform/sources/web/features/*"],

      // Code Sektor.
      "@app/*": ["./app/*"],

      "@env": ["./src/environments/environment"],

      // Pin Angular / i18n sur la copie Sektor (évite Signal NG19 vs NG20).
      "@angular/*": ["./node_modules/@angular/*"],
      "@ngx-translate/*": ["./node_modules/@ngx-translate/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "strictAttributeTypes": false,
    "strictDomEventTypes": false
  }
}
