# Migrations image of every product: the changelog generated by its build, the same SQL the lab applies (D-8).
# Context: <product>/sources/backend/build/resources/main (after bootJar).
FROM liquibase/liquibase:4.31
COPY nafura/db/ /liquibase/nafura/db/
ENV LIQUIBASE_COMMAND_CHANGELOG_FILE=nafura/db/changelog-master.yaml
ENTRYPOINT ["liquibase"]
CMD ["update"]
