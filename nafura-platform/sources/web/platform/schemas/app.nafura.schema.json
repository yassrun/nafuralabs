{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nafura.io/schemas/v1/app.nafura.schema.json",
  "title": "Nafura application manifest",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "nafura.io/v1" },
    "kind": { "const": "application" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["product", "runtime", "businessContexts"],
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "tagline": { "type": "string" },
            "mark": { "type": "string", "pattern": "^/[a-zA-Z0-9/_.-]+\\.(svg|png|webp)$" },
            "logo": { "type": "string", "pattern": "^/[a-zA-Z0-9/_.-]+\\.(svg|png|webp)$" }
          }
        },
        "runtime": {
          "type": "object",
          "required": ["defaultRoute"],
          "additionalProperties": false,
          "properties": {
            "tenancy": { "enum": ["single", "multi"] },
            "signup": { "enum": ["operator", "open"] },
            "defaultRoute": { "type": "string", "pattern": "^/" }
          }
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "topBar": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "pageContext": { "type": "boolean" } } },
            "sidebar": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" } } },
            "userMenu": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "userSettings": { "type": "boolean" },
                "userSettingsRoute": { "type": "string" }
              }
            },
            "tenantMenu": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "tenantSettings": { "type": "boolean" },
                "tenantSettingsRoute": { "type": "string" },
                "organizationIdentity": { "type": "boolean" },
                "organizationIdentityRoute": { "type": "string" },
                "fallbackName": { "type": "string" },
                "fallbackKey": { "type": "string" }
              }
            },
            "notifications": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" } } },
            "ai": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "initiallyOpen": { "type": "boolean" } } }
          }
        },
        "businessContexts": { "type": "array", "items": { "type": "string", "pattern": "^bc\\.[a-z][a-z0-9-]*$" } },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "disabled": { "type": "array", "items": { "type": "string", "pattern": "^cap\\.[a-z][a-z0-9-]*$" } }
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "label"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "label": { "type": "string" },
              "includes": { "type": "array", "items": { "type": "string", "pattern": "^bc\\.[a-z][a-z0-9-]*:[A-Z][A-Z0-9_]*$" } },
              "permissions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "provides": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "customRoles": { "type": "boolean" },
        "requires": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
        "i18n": { "$ref": "#/$defs/i18n" },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ports": {
              "type": "object",
              "required": ["api", "web"],
              "additionalProperties": false,
              "properties": { "api": { "type": "number" }, "web": { "type": "number" } }
            },
            "organizations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "name"],
                "additionalProperties": false,
                "properties": {
                  "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                  "name": { "type": "string" }
                }
              }
            },
            "users": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["email", "givenName", "familyName", "role"],
                "additionalProperties": false,
                "properties": {
                  "email": { "type": "string" },
                  "givenName": { "type": "string" },
                  "familyName": { "type": "string" },
                  "role": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                  "organizations": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                        {
                          "type": "object",
                          "required": ["key"],
                          "additionalProperties": false,
                          "properties": {
                            "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                            "role": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                            "audience": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "deploy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lab": { "$ref": "#/$defs/deployment" },
            "staging": { "$ref": "#/$defs/deployment" },
            "prod": { "$ref": "#/$defs/deployment" }
          }
        }
      }
    }
  },
  "$defs": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
        "owners": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^@\\s,'\"`$\\\\]+@[^@\\s,'\"`$\\\\]+$" },
          "uniqueItems": true
        },
        "operators": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^@\\s,'\"`$\\\\]+@[^@\\s,'\"`$\\\\]+$" },
          "uniqueItems": true
        }
      }
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "metadata": {
      "type": "object",
      "required": ["id", "version", "owner", "lifecycle"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^app\\.[a-z][a-z0-9-]*$" },
        "version": { "$ref": "#/$defs/version" },
        "owner": { "type": "string" },
        "lifecycle": { "enum": ["experimental", "production", "deprecated"] },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "capability": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "#/$defs/version" },
        "api": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\^\\d+\\.\\d+\\.\\d+$" },
        "optional": { "type": "boolean" },
        "api": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "string" } }
      }
    },
    "i18n": {
      "type": "object",
      "required": ["locales"],
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string" },
        "locales": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
