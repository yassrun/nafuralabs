{
  "name": "layali-mobile",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite -c client/vite.config.ts",
    "dev:pro": "vite -c pro/vite.config.ts",
    "dev:admin": "vite -c admin/vite.config.ts",
    "build": "npm run build:client && npm run build:pro && npm run build:admin",
    "build:client": "tsc -b && vite build -c client/vite.config.ts",
    "build:pro": "vite build -c pro/vite.config.ts",
    "build:admin": "vite build -c admin/vite.config.ts",
    "lint": "eslint client pro admin shared",
    "preview": "vite preview -c client/vite.config.ts"
  },
  "dependencies": {
    "@ionic/react": "^8.8.10",
    "@ionic/react-router": "^8.8.10",
    "ionicons": "^8.0.13",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
