FROM nginx:alpine
COPY products/usage-ops/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY products/usage-ops/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
