# Sektor BTP Web — image from pre-built Angular dist (monorepo root context):
#   npm install                      (workspaces, depuis la racine)
#   cd products/sektor-btp/web && npm run build:prod
#   docker build -t sektor-btp-web:staging -f products/sektor-btp/Dockerfile.web .

FROM nginx:alpine
COPY products/sektor-btp/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY products/sektor-btp/web/dist/project-fountain/browser /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
