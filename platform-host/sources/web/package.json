{
  "name": "@nafura/product-web",
  "version": "0.1.0",
  "private": true,
  "description": "Product web entry: app.nafura.json + BCs, everything else from nafura-platform",
  "scripts": {
    "stack:check": "node ../../../nafura-platform/scripts/sync-stack-versions.mjs --check",
    "ng": "ng",
    "start": "node ../../../nafura-platform/scripts/product-web.mjs serve",
    "build": "node ../../../nafura-platform/scripts/product-web.mjs build",
    "build:dev": "node ../../../nafura-platform/scripts/product-web.mjs build --configuration development"
  },
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@messageformat/core": "^3.4.0",
    "@ngx-translate/core": "^15.0.0",
    "chart.js": "^4.5.1",
    "lucide-angular": "^0.563.0",
    "marked": "15.0.12",
    "material-icons": "1.13.14",
    "ng2-charts": "^10.0.0",
    "ngx-translate-messageformat-compiler": "^7.2.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.5",
    "typescript": "~6.0.3"
  }
}
