{
  "entity": "demo.purchase-request",
  "initial": "DRAFT",
  "editable": ["DRAFT", "REJECTED"],
  "states": [
    { "id": "DRAFT", "label": "Brouillon", "tone": "default" },
    { "id": "SUBMITTED", "label": "En approbation", "tone": "warning" },
    { "id": "APPROVED", "label": "Approuvée", "tone": "success" },
    { "id": "REJECTED", "label": "Rejetée", "tone": "danger" },
    { "id": "ORDERED", "label": "Commandée", "tone": "info" }
  ],
  "transitions": [
    {
      "id": "submit",
      "label": "Soumettre",
      "from": ["DRAFT", "REJECTED"],
      "to": "SUBMITTED",
      "permission": "demo.purchasing.request.submit",
      "requires": ["subject", "supplierId", "amount"],
      "approval": {
        "role": "DEMO_LEAD",
        "when": "amount > 10000",
        "title": "Demande d’achat : {subject}",
        "approved": "approve",
        "rejected": "reject"
      }
    },
    { "id": "approve", "label": "Approuver", "from": ["SUBMITTED"], "to": "APPROVED", "system": true },
    { "id": "reject", "label": "Rejeter", "from": ["SUBMITTED"], "to": "REJECTED", "system": true },
    { "id": "order", "label": "Commander", "from": ["APPROVED"], "to": "ORDERED", "permission": "demo.purchasing.request.order" }
  ]
}
